# 🤖 USLUBA BOT - Environment Variables
# Faylni .env deb saqlab, token va sozlamalarni qo'ying

# 🔑 TELEGRAM BOT TOKEN (BotFather'dan olgan tokeningni qo'ying)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# 🐛 DEBUG MODE (test uchun: True, production uchun: False)
DEBUG=False
# =========================================
# 🌐 WEBHOOK MODE (Render deployment uchun)
# =========================================

# Your app's public URL on Render
PUBLIC_URL=https://your-app.render.com

# Secret token for webhook validation (xavfsiz random string qo'ying)
WEBHOOK_SECRET=your_random_secret_token_here

# Port number (Render 10000-10100 oralig'ida talab qiladi)
PORT=10000